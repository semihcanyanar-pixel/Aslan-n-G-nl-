rules_version = '2';

// Bebek Günlüğü — Firestore güvenlik kuralları.
// Firebase web anahtarı herkese açık olduğundan, "giriş yapmış herkes" kuralı
// yeterli değil: dışarıdan biri kendi hesabını açıp verilere erişebilirdi.
// Bu yüzden yalnızca aşağıdaki iki hesaba izin verilir.
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          "semihcan.yanar@hotmail.com",
          "seyma_saka@hotmail.com"
        ];
    }

    // Uygulamanın kullandığı koleksiyonlar: days, growth, meta
    match /days/{id} {
      allow read, write: if allowed();
    }
    match /growth/{id} {
      allow read, write: if allowed();
    }
    match /meta/{id} {
      allow read, write: if allowed();
    }
  }
}
